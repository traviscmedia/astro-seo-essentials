---
/**
 * src/components/SEO.astro
 * Everything SEO-related that belongs in <head>. Render it once, physically inside the
 * layout's <head> (Astro does not hoist <meta> out of nested components).
 * Requires `site` in astro.config.mjs.
 *
 * Deliberately does NOT emit <meta charset> or <meta viewport> — the layout owns those.
 */
import { SITE } from '../config/site'
import { absUrl, imageType, safeJsonLd, withContext, isoDate, devWarn } from '../lib/seo'

export interface SEOImage {
  /** Path in /public or absolute URL. */
  url: string
  alt?: string
  width?: number
  height?: number
  /** MIME type. Inferred from the extension when omitted. */
  type?: string
}

export interface SEOArticle {
  publishedTime?: string | Date
  modifiedTime?: string | Date
  expirationTime?: string | Date
  authors?: string[]
  section?: string
  tags?: string[]
}

export interface SEOTwitter {
  /** Overrides emit twitter:* tags even when SITE.twitterMirrorOg is false. */
  title?: string
  description?: string
  image?: string
  imageAlt?: string
  card?: 'summary' | 'summary_large_image'
}

export interface Props {
  /** Page title without the site suffix. Omit on the homepage to use SITE.homeTitle. */
  title?: string
  description?: string
  /** Shorthand for a single OG image. A bare string is a URL/path. */
  image?: string | SEOImage
  /** Absolute or site-relative. `false` omits the tag (and the og:url fallback). */
  canonical?: string | false
  noindex?: boolean
  nofollow?: boolean
  /** Replaces SITE.robotsExtras for this page. */
  robotsExtras?: string
  /** Defaults to 'article' when `article` is passed, else 'website'. */
  type?: 'website' | 'article' | 'product' | 'profile'
  article?: SEOArticle
  twitter?: SEOTwitter
  /** Extra JSON-LD node(s). @context is added if missing. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  /**
   * Derive an Article node from title/description/image/article/canonical.
   * Pass an object to merge overrides on top (e.g. { '@type': 'BlogPosting' }).
   */
  articleJsonLd?: boolean | Record<string, unknown>
  /** Overrides SITE.keywords for this page. */
  keywords?: string
}

if (!Astro.site) throw new Error('SEO.astro: `site` must be set in astro.config.mjs')
const site = Astro.site

const {
  title,
  description = SITE.description,
  image,
  canonical,
  noindex = false,
  nofollow = false,
  robotsExtras = SITE.robotsExtras,
  article,
  twitter,
  jsonLd,
  articleJsonLd,
  keywords = SITE.keywords,
} = Astro.props
const type = Astro.props.type ?? (article ? 'article' : 'website')

// ---- Title ---------------------------------------------------------------
const rawTitle = title ?? SITE.name
const pageTitle = title
  ? (SITE.titleTemplate ? SITE.titleTemplate.replace('%s', title) : title)
  : SITE.homeTitle.replace('{year}', String(new Date().getFullYear()))

// ---- Canonical -----------------------------------------------------------
const canonicalURL = canonical === false
  ? undefined
  : absUrl(canonical ?? Astro.url.pathname, site)

// ---- Robots --------------------------------------------------------------
const robots = [
  noindex ? 'noindex' : 'index',
  nofollow ? 'nofollow' : 'follow',
  ...(robotsExtras ? [robotsExtras] : []),
].join(', ')

// ---- Image ---------------------------------------------------------------
const img: SEOImage = typeof image === 'string'
  ? { url: image }
  : image ?? {
      url: SITE.ogImage,
      alt: SITE.ogImageAlt,
      width: SITE.ogImageWidth,
      height: SITE.ogImageHeight,
    }
const ogImageURL = absUrl(img.url, site)
const ogImageAlt = img.alt ?? title ?? SITE.name
const ogImageType = img.type ?? (ogImageURL ? imageType(ogImageURL) : undefined)

// ---- Article -------------------------------------------------------------
const published = isoDate(article?.publishedTime)
const modified = isoDate(article?.modifiedTime) ?? published
const expires = isoDate(article?.expirationTime)

// ---- Twitter -------------------------------------------------------------
const twCard = twitter?.card ?? 'summary_large_image'
const twTitle = twitter?.title ?? (SITE.twitterMirrorOg ? rawTitle : undefined)
const twDesc = twitter?.description ?? (SITE.twitterMirrorOg ? description : undefined)
const twImage = absUrl(twitter?.image, site) ?? (SITE.twitterMirrorOg ? ogImageURL : undefined)
const twImageAlt = twitter?.imageAlt ?? (twImage ? ogImageAlt : undefined)

// ---- JSON-LD -------------------------------------------------------------
const nodes: Record<string, unknown>[] = []
if (jsonLd) nodes.push(...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]))

const hasArticleNode = nodes.some((n) => /Article|Posting$/.test(String(n['@type'] ?? '')))
if (articleJsonLd && !hasArticleNode) {
  if (!title || !article) {
    devWarn('SEO', 'articleJsonLd needs both `title` and `article` — nothing emitted.')
  } else {
    const authors = (article.authors?.length ? article.authors : [SITE.author]).map((a) =>
      /^https?:\/\//.test(a) ? { '@type': 'Person', url: a } : { '@type': 'Person', name: a },
    )
    const derived: Record<string, unknown> = {
      '@type': 'Article',
      ...(canonicalURL && {
        '@id': `${canonicalURL}#article`,
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
      }),
      headline: rawTitle,
      description,
      ...(ogImageURL && { image: [ogImageURL] }),
      ...(published && { datePublished: published }),
      ...(modified && { dateModified: modified }),
      author: authors.length === 1 ? authors[0] : authors,
      publisher: { '@type': 'Organization', name: SITE.name, url: site.href },
      ...(article.section && { articleSection: article.section }),
      ...(article.tags?.length && { keywords: article.tags.join(', ') }),
    }
    nodes.push(typeof articleJsonLd === 'object' ? { ...derived, ...articleJsonLd } : derived)
  }
}
const jsonLdOut = nodes.length ? safeJsonLd(withContext(nodes.length === 1 ? nodes[0] : nodes)) : undefined

// ---- Dev warnings --------------------------------------------------------
if (!description) devWarn('SEO', `No description on ${Astro.url.pathname}`)
if (ogImageURL && !img.alt && !title) devWarn('SEO', `og:image on ${Astro.url.pathname} has no alt`)
if (description && description.length > 160) devWarn('SEO', `Description on ${Astro.url.pathname} is ${description.length} chars`)
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
<meta name="author" content={SITE.author} />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content={robots} />
{canonicalURL && <link rel="canonical" href={canonicalURL} />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
{canonicalURL && <meta property="og:url" content={canonicalURL} />}
<meta property="og:title" content={rawTitle} />
<meta property="og:description" content={description} />
{ogImageURL && <meta property="og:image" content={ogImageURL} />}
{ogImageURL && <meta property="og:image:alt" content={ogImageAlt} />}
{ogImageURL && ogImageType && <meta property="og:image:type" content={ogImageType} />}
{ogImageURL && img.width && <meta property="og:image:width" content={String(img.width)} />}
{ogImageURL && img.height && <meta property="og:image:height" content={String(img.height)} />}
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
{type === 'article' && published && <meta property="article:published_time" content={published} />}
{type === 'article' && modified && <meta property="article:modified_time" content={modified} />}
{type === 'article' && expires && <meta property="article:expiration_time" content={expires} />}
{type === 'article' && article?.authors?.map((a) => <meta property="article:author" content={a} />)}
{type === 'article' && article?.section && <meta property="article:section" content={article.section} />}
{type === 'article' && article?.tags?.map((t) => <meta property="article:tag" content={t} />)}

<!-- Twitter / X (falls back to og:* unless overridden) -->
<meta name="twitter:card" content={twCard} />
{SITE.twitterSite && <meta name="twitter:site" content={SITE.twitterSite} />}
{twTitle && <meta name="twitter:title" content={twTitle} />}
{twDesc && <meta name="twitter:description" content={twDesc} />}
{twImage && <meta name="twitter:image" content={twImage} />}
{twImage && twImageAlt && <meta name="twitter:image:alt" content={twImageAlt} />}

<!-- Icons & theme -->
{SITE.favicon && <link rel="icon" type={imageType(SITE.favicon) ?? 'image/x-icon'} href={SITE.favicon} />}
{SITE.appleTouchIcon && <link rel="apple-touch-icon" href={SITE.appleTouchIcon} />}
{SITE.themeColor && <meta name="theme-color" content={SITE.themeColor} />}

<!-- Optional extras -->
{SITE.geo && <meta name="geo.region" content={SITE.geo.region} />}
{SITE.geo && <meta name="geo.placename" content={SITE.geo.placename} />}
{SITE.hreflang && canonicalURL && <link rel="alternate" hreflang="en" href={canonicalURL} />}
{SITE.hreflang && canonicalURL && <link rel="alternate" hreflang="x-default" href={canonicalURL} />}

{jsonLdOut && <script type="application/ld+json" set:html={jsonLdOut} />}
